# Copy to `.env` for a local `docker compose` run, or paste into Dokploy's
# Environment tab (Dokploy writes the tab's contents to `.env` beside
# compose.yml).

# Public origin of the site. Baked into the prerendered pages — metadataBase,
# OpenGraph URLs, sitemap.xml and robots.txt — at BUILD time, so changing it
# requires rebuilding the image (it is passed as a build arg).
SITE_URL=https://docs.example.com
