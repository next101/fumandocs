# Copy to `.env` for a local `docker compose` run, or paste into Dokploy's
# Environment tab (Dokploy writes the tab's contents to `.env` beside
# compose.yml).

# Public origin of the site. Baked into the prerendered pages — metadataBase,
# OpenGraph URLs, sitemap.xml and robots.txt — at BUILD time, so changing it
# requires rebuilding the image (it is passed as a build arg).
SITE_URL=https://docs.example.com

# Plausible Analytics (optional). Leave NEXT_PUBLIC_PLAUSIBLE_ENABLED as `false`
# to load nothing; tracking starts only when it is `true` and both the domain and
# the endpoint are non-empty. These are public values, and `NEXT_PUBLIC_*` is
# inlined into the client bundle at BUILD time (also passed as compose build
# args), so changing them requires rebuilding the image.
NEXT_PUBLIC_PLAUSIBLE_ENABLED=false
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=docs.example.com
NEXT_PUBLIC_PLAUSIBLE_ENDPOINT=https://plausible.io/api/event
