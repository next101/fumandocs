{
  "name": "create-fumandocs",
  "version": "0.1.0",
  "description": "Create a Fumadocs documentation site with Mantine UI",
  "keywords": [
    "docs",
    "fumadocs",
    "mantine",
    "fumandocs"
  ],
  "license": "MIT",
  "author": "Xiao Hanyu (https://xiaohanyu.me)",
  "repository": {
    "type": "git",
    "url": "https://github.com/next101/fumandocs",
    "directory": "packages/create-fumandocs"
  },
  "bin": "./dist/bin.js",
  "files": [
    "dist",
    "template"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "clean": "rimraf dist",
    "dev": "tsx src/bin.ts",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@commander-js/extra-typings": "^15.0.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "tinyexec": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "rimraf": "^6.1.3",
    "tsconfig": "workspace:*",
    "tsdown": "0.23.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
