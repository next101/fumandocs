{
  "name": "fumandocs-ui",
  "version": "0.1.0",
  "description": "Mantine UI layer for Fumandocs (Fumadocs-compatible exports)",
  "keywords": [
    "docs",
    "fumadocs",
    "mantine",
    "fumandocs"
  ],
  "license": "MIT",
  "author": "Xiao Hanyu (https://xiaohanyu.me)",
  "repository": {
    "type": "git",
    "url": "https://github.com/next101/fumandocs",
    "directory": "packages/fumandocs-ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./components/callout": {
      "types": "./dist/components/callout.d.ts",
      "default": "./dist/components/callout.js"
    },
    "./components/card": {
      "types": "./dist/components/card.d.ts",
      "default": "./dist/components/card.js"
    },
    "./components/codeblock": {
      "types": "./dist/components/codeblock.d.ts",
      "default": "./dist/components/codeblock.js"
    },
    "./components/heading": {
      "types": "./dist/components/heading.d.ts",
      "default": "./dist/components/heading.js"
    },
    "./layouts/docs": {
      "types": "./dist/layouts/docs/index.d.ts",
      "default": "./dist/layouts/docs/index.js"
    },
    "./layouts/docs/page": {
      "types": "./dist/layouts/docs/page.d.ts",
      "default": "./dist/layouts/docs/page.js"
    },
    "./layouts/shared": {
      "types": "./dist/layouts/shared.d.ts",
      "default": "./dist/layouts/shared.js"
    },
    "./mdx": {
      "types": "./dist/mdx.d.ts",
      "node": "./dist/mdx.server.js",
      "import": "./dist/mdx.js"
    },
    "./provider/base": {
      "types": "./dist/provider/base.d.ts",
      "default": "./dist/provider/base.js"
    },
    "./provider/next": {
      "types": "./dist/provider/next.d.ts",
      "default": "./dist/provider/next.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "default": "./dist/search.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --clean false",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@mantine/core": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@tsdown/css": "^0.23.0",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "fumadocs-core": "^16.15.12",
    "next": "16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "tsconfig": "workspace:*",
    "tsdown": "0.22.14",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@mantine/core": "9.x.x",
    "@mantine/hooks": "9.x.x",
    "fumadocs-core": "15.x.x || 16.x.x",
    "next": "15.x.x || 16.x.x",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "rehype-raw": "^7.0.0"
  }
}
